# ============================================================
# Lovia Environment Variables Example
# Скопируйте этот файл в .env.local для локальной разработки
# или добавьте эти переменные в настройках Vercel
# ============================================================

# Supabase (Postgres + Realtime + Storage)
# Получите в панели Supabase -> Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Telegram Bot Token (для серверной валидации HMAC-SHA256 в /api/auth/telegram)
# Получите у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Google Maps API Key (опционально, для поиска мест свиданий)
VITE_GOOGLE_MAPS_API_KEY=
